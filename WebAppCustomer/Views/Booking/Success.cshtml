
@model Booking

@{
    ViewData["Title"] = "Đặt phòng thành công";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

<style>
    body { font-family: 'DM Sans', sans-serif; background: #f5f0eb; }
    .wrapper { max-width: 520px; margin: 60px auto; padding: 0 20px; }
    .card {
        background: #fff; border-radius: 20px;
        padding: 40px 36px; box-shadow: 0 4px 24px rgba(0,0,0,0.09);
        text-align: center;
    }
    .icon { font-size: 3.5rem; margin-bottom: 12px; }
    h1 { font-family: 'Playfair Display', serif; font-size: 1.6rem; color: #2c6e49; margin-bottom: 8px; }
    .subtitle { color: #888; font-size: 0.9rem; margin-bottom: 28px; }

    .info-box {
        background: #f8f8f8; border-radius: 12px;
        padding: 18px 20px; margin-bottom: 16px; text-align: left;
    }
    .info-row { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 8px; color: #555; }
    .info-row:last-child { margin-bottom: 0; }
    .info-row .label { color: #999; }
    .info-row .value { font-weight: 500; color: #1a1a1a; }

    .highlight-box {
        background: #1a1a1a; border-radius: 12px;
        padding: 18px 20px; margin-bottom: 20px; text-align: left;
    }
    .highlight-box .hrow { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 6px; color: #bbb; }
    .highlight-box .hrow.total { color: #fff; font-weight: 500; font-size: 1rem; border-top: 1px solid #333; padding-top: 8px; margin-top: 4px; }
    .highlight-box .hrow.deposit { color: #81c995; font-weight: 500; }

    .badge {
        display: inline-block; background: #e8f5e9; color: #2c6e49;
        border-radius: 20px; padding: 4px 14px; font-size: 0.82rem;
        font-weight: 500; margin-bottom: 20px;
    }

    .btn-back {
        display: inline-block; padding: 12px 32px;
        background: #2c6e49; color: #fff; text-decoration: none;
        border-radius: 10px; font-family: 'DM Sans', sans-serif;
        font-size: 0.95rem; font-weight: 500;
    }
    .btn-back:hover { background: #1e4d33; }
</style>

<div class="wrapper">
    <div class="card">
        <div class="icon">🎉</div>
        <h1>🎉🎉Đặt phòng thành công!🎉🎉</h1>
        <p class="subtitle">Cảm ơn bạn đã đặt phòng. Chúng tôi sẽ sớm liên hệ xác nhận.</p>

        <div class="badge">✓ Mã booking: #@ViewBag.BookingIDs</div>

        <div class="info-box">
            <div class="info-row">
                <span class="label">Khách hàng</span>
                <span class="value">@ViewBag.HoTen</span>
            </div>
            <div class="info-row">
                <span class="label">Mã khách hàng</span>
                <span class="value">@ViewBag.MaKH</span>
            </div>
            <div class="info-row">
                <span class="label">Số điện thoại</span>
                <span class="value">@ViewBag.SoDienThoai</span>
            </div>
            <div class="info-row">
                <span class="label">Email</span>
                <span class="value">@ViewBag.Email</span>
            </div>
            <div class="info-row">
                <span class="label">Số phòng đặt</span>
                <span class="value">@ViewBag.SoPhong phòng</span>
            </div>
            <div class="info-row">
                <span class="label">Tên phòng</span>
                <span class="value">@ViewBag.TenPhong</span>
            </div>
            <div class="info-row">
                <span class="label">Check-in</span>
                <span class="value">@Model.CheckInDate.ToString("dd/MM/yyyy") lúc 14:00</span>
            </div>
            <div class="info-row">
                <span class="label">Check-out</span>
                <span class="value">@Model.CheckOutDate.ToString("dd/MM/yyyy") lúc 12:00</span>
            </div>
            <div class="info-row">
                <span class="label">Thời gian đặt</span>
                <span class="value">@Model.BookingDate?.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>

        <div class="highlight-box">
            <div class="hrow total">
                <span>Tổng tiền</span>
                <span>@Model.TotalPrice.ToString("N0") VNĐ</span>
            </div>
            <div class="hrow deposit">
                <span>Tiền cọc (50%)</span>
                <span>@Model.Deposit?.ToString("N0") VNĐ</span>
            </div>
        </div>

        <a href="/Room/Index" class="btn-back">← Quay lại trang chủ</a>
    </div>
</div>

<script>
    // Xóa giỏ hàng sau khi đặt thành công
    sessionStorage.removeItem('bookingCart');
</script>
