@{
    ViewData["Title"] = "Tiện nghi";
}

<div class="amenities-page">

    <div class="section-head">
        <div class="mini-title">✦ TIỆN NGHI</div>

        <h1>Dịch vụ đẳng cấp</h1>
    </div>

    <div class="amenities-grid">

        <!-- GIẢI TRÍ -->
        <div class="amenity-card">

            <div class="amenity-icon">🎮</div>

            <div class="amenity-title">
                Giải trí
            </div>

            <div class="amenity-desc">
                Khu giải trí hiện đại với karaoke,
                game và không gian thư giãn.
            </div>

        </div>

        <!-- XE MÁY -->
        <div class="amenity-card">

            <div class="amenity-icon">🏍️</div>

            <div class="amenity-title">
                Cho thuê xe máy
            </div>

            <div class="amenity-desc">
                Hỗ trợ thuê xe máy nhanh chóng,
                thuận tiện khám phá thành phố.
            </div>

        </div>

        <!-- NHÀ HÀNG -->
        <div class="amenity-card">

            <div class="amenity-icon">🍽️</div>

            <div class="amenity-title">
                Nhà hàng
            </div>

            <div class="amenity-desc">
                Ẩm thực Việt và quốc tế,
                phục vụ cả ngày.
            </div>

        </div>

        <!-- BÃI XE -->
        <div class="amenity-card">

            <div class="amenity-icon">🅿️</div>

            <div class="amenity-title">
                Bãi đỗ xe
            </div>

            <div class="amenity-desc">
                Bãi đỗ xe miễn phí,
                bảo vệ 24/7.
            </div>

        </div>

    </div>

</div>